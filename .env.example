# Set these in your shell; .env is documentation, not automatically loaded.
AWS_REGION=us-east-2
DYNAMODB_TRIPS_TABLE=SyncTripTrips
DYNAMODB_ACTIVITIES_TABLE=SyncTripActivities
# AWS_PROFILE=default
# Optional DynamoDB Local endpoint (never set this for live AWS):
# DYNAMODB_ENDPOINT_URL=http://localhost:8001
# Legacy DYNAMODB_TABLE_NAME is a fallback for DYNAMODB_TRIPS_TABLE only.
